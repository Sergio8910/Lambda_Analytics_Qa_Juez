# Copiar este archivo a `.env` y rellenar los valores.
# `.env` está en .gitignore — NUNCA commitearlo con valores reales.

APP_NAME=AI Eval Service
ENV=dev

# ─────────────────────────────────────────────────────────────────────────────
# Juez — evaluación de agentes (carpeta `juez/`)
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI — usado por el motor LLM del Juez y los runners
OPENAI_API_KEY=

# LangWatch (opcional) — observabilidad de evaluaciones
LANGWATCH_API_KEY=
ENABLE_LANGWATCH=true

# Modelo del juez/judge LLM (gpt-4o-mini, gpt-4o, etc.)
JUDGE_MODEL=gpt-4o-mini

# n8n — para descargar flows vía API y evitar pasar --n8n-url manualmente
N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_API_KEY=

# ElevenLabs — para descargar agent configs vía API
ELEVENLABS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Verificador post-ejecución (carpeta `verificador/`)
# Producto independiente del Juez. Audita PDFs/imágenes/etc generados por
# flows productivos.
# ─────────────────────────────────────────────────────────────────────────────

# API key requerida en header `X-Verifier-Key` para todos los requests al
# verificador. Rotable. Sin valor → todos los requests devuelven 503.
VERIFICADOR_API_KEY=

# Puerto donde levanta FastAPI standalone (uvicorn verificador.app:app)
VERIFICADOR_PORT=8001

# BD propia del verificador. Si no se setea, usa SQLite local en
# outputs/verificador.db (suficiente para dev y MVP).
# En producción, apuntar a Postgres y se crea el schema `verificador`.
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Conexión read-only a la BD productiva de Abad Faciolince
# Recomendado: usuario dedicado `verificador_ro` con GRANT SELECT solo sobre
# las tablas que `juez/clientes/abad.py` consulta. NUNCA usar superuser.
ABAT_DB_URL=

# Google Drive — token OAuth2 para descargar PDFs de los inventarios
# Recomendado a futuro: migrar a service account con scope drive.readonly
GOOGLE_OAUTH_TOKEN=

# Ajustes operativos (todos tienen default razonable)
VERIFICADOR_DRIVE_TIMEOUT_S=60
VERIFICADOR_DRIVE_RETRY_DELAY_S=3
VERIFICADOR_DRIVE_RETRY_MAX=3
VERIFICADOR_CLIENT_DB_TIMEOUT_MS=5000
VERIFICADOR_MAX_ARTIFACT_BYTES=52428800
VERIFICADOR_LOG_LEVEL=INFO
